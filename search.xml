  <span class="punctuation">&#125;</span><span class="punctuation">,</span></span><br><span class="line">    <span class="punctuation">&#123;</span></span><br><span class="line">      <span class="attr">&quot;before&quot;</span><span class="punctuation">:</span> <span class="punctuation">[</span><span class="string">&quot;J&quot;</span><span class="punctuation">]</span><span class="punctuation">,</span></span><br><span class="line">      <span class="attr">&quot;commands&quot;</span><span class="punctuation">:</span> <span class="punctuation">[</span></span><br><span class="line">        <span class="punctuation">&#123;</span></span><br><span class="line">          <span class="attr">&quot;command&quot;</span><span class="punctuation">:</span> <span class="string">&quot;editor.action.moveLinesDownAction&quot;</span></span><br><span class="line">        <span class="punctuation">&#125;</span></span><br><span class="line">      <span class="punctuation">]</span></span><br><span class="line">    <span class="punctuation">&#125;</span><span class="punctuation">,</span></span><br><span class="line">    <span class="punctuation">&#123;</span></span><br><span class="line">      <span class="attr">&quot;before&quot;</span><span class="punctuation">:</span> <span class="punctuation">[</span><span class="string">&quot;K&quot;</span><span class="punctuation">]</span><span class="punctuation">,</span></span><br><span class="line">      <span class="attr">&quot;commands&quot;</span><span class="punctuation">:</span> <span class="punctuation">[</span></span><br><span class="line">        <span class="punctuation">&#123;</span></span><br><span class="line">          <span class="attr">&quot;command&quot;</span><span class="punctuation">:</span> <span class="string">&quot;editor.action.moveLinesUpAction&quot;</span></span><br><span class="line">        <span class="punctuation">&#125;</span></span><br><span class="line">      <span class="punctuation">]</span></span><br><span class="line">    <span class="punctuation">&#125;</span></span><br><span class="line">  <span class="punctuation">]</span></span><br></pre></td></tr></table></figure>

<h2 id="IdeaVim-Keymap"><a href="#IdeaVim-Keymap" class="headerlink" title="IdeaVim Keymap"></a>IdeaVim Keymap</h2><figure class="highlight plaintext"><table><tr><td class="code"><pre><span class="line">&quot; Basic setting</span><br><span class="line">set showmode</span><br><span class="line">set relativenumber</span><br><span class="line">set clipboard += unnamed</span><br><span class="line">set keep-english-in-normal</span><br><span class="line"></span><br><span class="line">&quot; Set leader key</span><br><span class="line">let mapleader = &quot; &quot;</span><br><span class="line"></span><br><span class="line">&quot; Search setting</span><br><span class="line">set incsearch</span><br><span class="line">set hlsearch</span><br><span class="line">set ignorecase</span><br><span class="line">set smartcase</span><br><span class="line"></span><br><span class="line">&quot; Plugins</span><br><span class="line">set easymotion</span><br><span class="line">set surround</span><br><span class="line">set NERDTree</span><br><span class="line"></span><br><span class="line">&quot; Basic key mapping</span><br><span class="line">inoremap jk &lt;esc&gt;</span><br><span class="line">nnoremap ; :</span><br><span class="line">nnoremap &lt;leader&gt;h :nohlsearch&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;d &lt;c-d&gt;</span><br><span class="line">nnoremap &lt;leader&gt;u &lt;c-u&gt;</span><br><span class="line">nnoremap &lt;leader&gt;q :wq&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;w :w&lt;cr&gt;</span><br><span class="line"></span><br><span class="line">&quot; Windows operation</span><br><span class="line">nnoremap \ &lt;c-W&gt;v</span><br><span class="line">nnoremap - &lt;c-W&gt;s</span><br><span class="line">nnoremap &lt;leader&gt;wh &lt;c-W&gt;h</span><br><span class="line">nnoremap &lt;leader&gt;wj &lt;c-W&gt;j</span><br><span class="line">nnoremap &lt;leader&gt;wk &lt;c-W&gt;k</span><br><span class="line">nnoremap &lt;leader&gt;wl &lt;c-W&gt;l</span><br><span class="line"></span><br><span class="line">&quot; Tabs operation</span><br><span class="line">nnoremap H gT</span><br><span class="line">nnoremap L gt</span><br><span class="line"></span><br><span class="line">&quot; Config IdeaVim</span><br><span class="line">nnoremap &lt;leader&gt;ve :e ~/.ideavimrc&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;vs :source ~/.ideavimrc&lt;cr&gt;</span><br><span class="line"></span><br><span class="line">&quot; Coding</span><br><span class="line">nnoremap gi :action GotoImplementation&lt;cr&gt;</span><br><span class="line">nnoremap gd :action GotoDeclaration&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;e :action ActivateProjectToolWindow&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;gf :action GotoFile&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;/ :action CommentByLineComment&lt;cr&gt;</span><br><span class="line">vnoremap &lt;leader&gt;/ :action CommentByLineComment&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;nj :action NewClass&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;mr :action Maven.Reimport&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;= :action ReformatCode&lt;cr&gt;</span><br><span class="line">nnoremap &lt;leader&gt;- :action OptimizeImports&lt;cr&gt;</span><br></pre></td></tr></table></figure>]]></content>
